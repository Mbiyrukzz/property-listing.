page Contact

import LeadForm from "./components/LeadForm"
import { IconPhone, IconMail, IconMapPin, IconWhatsapp, IconClock, IconCheck, IconArrowRight } from "tylix-icons"

title "Contact Barani Better Homes"

uses
  Site
  Fmt

state
  topic: "property"
  landlordServices: [
    "Marketing vacant units and finding tenants",
    "Tenant vetting and lease paperwork",
    "Rent collection and arrears follow-up",
    "Repairs and maintenance, arranged for you",
    "Clear statements so you always know where things stand"
  ]

computed
  message() {
    if this.topic is "landlord" {
      return "I own a rental property and I'd like to talk about rent collection and property management. My property is in…"
    }
    return ""
  }

  intro() {
    if this.topic is "landlord" {
      return "Tell us a little about your property: where it is, how many units, and what you need help with. We'll call you back to talk it through."
    }
    return "Looking for something you can't find, or need help with your tenancy? Send a message and we'll call you back."
  }

action
  setTopic(value) {
    this.topic = value
  }

  askLandlord() {
    this.topic = "landlord"
    const el = document.getElementById("contact-form-heading")
    if el {
      el.scrollIntoView({ behavior: "smooth", block: "start" })
    }
  }

  segClass(value) {
    return this.topic is value ? "is-on" : ""
  }

onMount
  {
    const p = new URLSearchParams(window.location.search)
    if p.get("topic") is "landlord" {
      this.topic = "landlord"
    }
  }

template
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <p class="tx-eyebrow mb-2">Contact us</p>
    <h1 class="text-[1.75rem] leading-tight sm:text-4xl font-bold tracking-tight">Talk to us</h1>
    <p class="text-soft mt-2 max-w-2xl leading-relaxed">Whether you're looking for a place or you own one, we're a message away.</p>

    <div class="grid md:grid-cols-2 gap-3 mt-6 mb-8">
{{#if Site.settings.whatsapp}}
      <a href="{{ Fmt.whatsapp(Site.settings.whatsapp, 'Hello Barani Better Homes') }}" target="_blank" rel="noopener" class="tx-panel p-4 flex items-center gap-3">
        <span class="bb-icon-tile bb-tint-leaf"><IconWhatsapp /></span>
        <span class="min-w-0 flex-1">
          <span class="block text-xs font-semibold text-muted">WhatsApp</span>
          <span class="block font-bold truncate">{{ Site.settings.whatsapp }}</span>
        </span>
        <IconArrowRight class="w-4 h-4 text-muted" />
      </a>
{{/if}}
{{#if Site.settings.email}}
      <a href="{{ `mailto:${Site.settings.email}` }}" class="tx-panel p-4 flex items-center gap-3">
        <span class="bb-icon-tile bb-tint-lilac"><IconMail /></span>
        <span class="min-w-0 flex-1">
          <span class="block text-xs font-semibold text-muted">Email</span>
          <span class="block font-bold truncate">{{ Site.settings.email }}</span>
        </span>
        <IconArrowRight class="w-4 h-4 text-muted" />
      </a>
{{/if}}
    </div>

    <div class="grid lg:grid-cols-[1fr_360px] gap-6 lg:gap-8 items-start">
      <section aria-labelledby="contact-form-heading">
        <h2 id="contact-form-heading" class="text-lg font-bold mb-3 scroll-mt-24">Send us a message</h2>
        <div class="bb-seg bb-seg-full sm:inline-flex mb-3 whitespace-nowrap" role="radiogroup" aria-label="What is this about?">
          <button type="button" role="radio" aria-checked="{{ topic is 'property' }}" class="{{ segClass('property') }}" onclick="{{ setTopic('property') }}">Looking for a property</button>
          <button type="button" role="radio" aria-checked="{{ topic is 'landlord' }}" class="{{ segClass('landlord') }}" onclick="{{ setTopic('landlord') }}">I'm a landlord</button>
        </div>
        <p class="text-sm text-muted mb-4 max-w-xl">{{ intro }}</p>
        <LeadForm listingId="{{ null }}" units="{{ [] }}" purpose="" defaultMessage="{{ message }}" />
      </section>

      <aside class="flex flex-col gap-4">
        <div id="landlords" class="rounded-[22px] bg-night text-white p-5 sm:p-6">
          <p class="tx-eyebrow !text-[#C4BAFF] mb-2">For landlords</p>
          <h2 class="text-xl font-bold tracking-tight mb-2">We'll manage it for you</h2>
          <p class="text-sm text-white/70 leading-relaxed mb-4">Rent collection and full property management, from a single unit to a whole block.</p>
          <ul class="space-y-2.5 mb-5">
{{#each s in landlordServices}}
            <li class="flex items-start gap-2.5 text-sm text-white/85">
              <span class="w-5 h-5 mt-px rounded-full bg-white/10 text-butter flex items-center justify-center shrink-0"><IconCheck class="w-3 h-3" /></span>
              {{ s }}
            </li>
{{/each}}
          </ul>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="tx-btn tx-btn-sm bg-white !text-[#1B183D] hover:bg-lilac" onclick="{{ askLandlord() }}">Ask about management</button>
            <a href="/p/about" class="tx-btn tx-btn-sm text-white border-white/20 hover:bg-white/10">About us</a>
          </div>
        </div>

        <div class="tx-panel p-5 space-y-3.5 text-sm">
{{#if Site.settings.phone}}
          <a href="{{ `tel:${Site.settings.phone}` }}" class="flex items-center gap-3 hover:text-link"><span class="bb-icon-tile bb-icon-tile-sm bb-tint-lilac"><IconPhone /></span> {{ Site.settings.phone }}</a>
{{/if}}
{{#if Site.settings.address}}
          <p class="flex items-start gap-3"><span class="bb-icon-tile bb-icon-tile-sm bb-tint-apricot"><IconMapPin /></span> <span class="pt-2">{{ Site.settings.address }}</span></p>
{{/if}}
{{#if Site.settings.office_hours}}
          <p class="flex items-center gap-3 text-soft"><span class="bb-icon-tile bb-icon-tile-sm bb-tint-butter"><IconClock /></span> {{ Site.settings.office_hours }}</p>
{{/if}}
          <p class="text-xs text-muted pt-1">We usually reply by phone or WhatsApp the same working day.</p>
        </div>
      </aside>
    </div>
  </div>
