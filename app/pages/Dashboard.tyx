page Dashboard

import AccountNav from "./components/AccountNav"
import { IconHeart, IconClipboardList, IconCalendar, IconChatBubble, IconKey, IconArrowRight, IconAlertOctagon } from "tylix-icons"

title "My account | Barani Better Homes"

needs
  Auth

uses
  Fmt

meta
  transition "fade"

state
  ready: false
  counts: { saved: 0, enquiries: 0, viewings: 0, applications: 0 }
  recent: []
  profile: null
  loadError: ""

computed
  greeting() {
    const hour = new Date().getHours()
    if hour < 12 {
      return "Good morning"
    }
    if hour < 18 {
      return "Good afternoon"
    }
    return "Good evening"
  }

action
  typeLabel(type) {
    if type is "viewing" {
      return "Viewing request"
    }
    if type is "application" {
      return "Application"
    }
    return "Enquiry"
  }

  chip(status) {
    if status is "approved" or status is "confirmed" or status is "completed" {
      return "bb-chip bb-chip-ok"
    }
    if status is "rejected" or status is "cancelled" or status is "withdrawn" {
      return "bb-chip bb-chip-bad"
    }
    if status is "closed" {
      return "bb-chip bb-chip-muted"
    }
    return "bb-chip bb-chip-warn"
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }
    const result = await useApi("/api/account/overview")
    if result.ok {
      this.counts = result.data.counts
      this.recent = result.data.recent
      this.profile = result.data.profile
    } else {
      this.loadError = "Your account summary couldn't be loaded. Refresh to try again."
    }
    this.ready = true
  }

template
{{#if Auth.user}}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-8 grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-4 lg:gap-8">
    <AccountNav current="overview" />

    <div class="min-w-0">
      <p class="tx-eyebrow mb-2">{{ greeting }}</p>
      <h1 class="text-[1.75rem] leading-tight sm:text-3xl font-bold tracking-tight mb-6">{{ Auth.user.name }}</h1>

{{#if loadError}}
      <div class="tx-alert tx-alert-error mb-6"><p class="text-sm">{{ loadError }}</p></div>
{{/if}}

{{#if ready and profile and not profile.emailVerified}}
      <div class="tx-alert tx-alert-info mb-6 flex items-start gap-2"><IconAlertOctagon class="w-4 h-4 mt-0.5 shrink-0" /><p class="text-sm">Confirm your email address (check your inbox) so we can send you viewing confirmations.</p></div>
{{/if}}

      <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 mb-6 sm:mb-8">
        <a href="/account/saved" class="tx-panel p-4 sm:p-5 flex flex-col gap-3">
          <span class="bb-icon-tile bb-icon-tile-sm bb-tint-blush"><IconHeart /></span>
          <div><p class="text-2xl sm:text-[1.75rem] font-bold tracking-tight leading-none">{{ counts.saved }}</p><p class="text-xs text-muted mt-1.5">Saved properties</p></div>
        </a>
        <a href="/account/activity" class="tx-panel p-4 sm:p-5 flex flex-col gap-3">
          <span class="bb-icon-tile bb-icon-tile-sm bb-tint-apricot"><IconCalendar /></span>
          <div><p class="text-2xl sm:text-[1.75rem] font-bold tracking-tight leading-none">{{ counts.viewings }}</p><p class="text-xs text-muted mt-1.5">Upcoming viewings</p></div>
        </a>
        <a href="/account/activity" class="tx-panel p-4 sm:p-5 flex flex-col gap-3">
          <span class="bb-icon-tile bb-icon-tile-sm bb-tint-lilac"><IconClipboardList /></span>
          <div><p class="text-2xl sm:text-[1.75rem] font-bold tracking-tight leading-none">{{ counts.applications }}</p><p class="text-xs text-muted mt-1.5">Applications in review</p></div>
        </a>
        <a href="/account/activity" class="tx-panel p-4 sm:p-5 flex flex-col gap-3">
          <span class="bb-icon-tile bb-icon-tile-sm bb-tint-leaf"><IconChatBubble /></span>
          <div><p class="text-2xl sm:text-[1.75rem] font-bold tracking-tight leading-none">{{ counts.enquiries }}</p><p class="text-xs text-muted mt-1.5">Enquiries sent</p></div>
        </a>
      </div>

      <div class="grid xl:grid-cols-[1fr_320px] gap-4 sm:gap-6 items-start">
        <section class="tx-panel overflow-hidden">
          <div class="flex items-center justify-between px-5 py-4 border-b border-line">
            <h2 class="font-semibold">Recent activity</h2>
            <a href="/account/activity" class="text-sm tx-link">See all</a>
          </div>
{{#if not ready}}
          <p class="p-4 text-sm text-muted">Loading…</p>
{{#else if recent.length is 0}}
          <div class="p-6 text-center">
            <p class="text-sm text-muted mb-4">Nothing yet. Find a place you like, then book a viewing or apply.</p>
            <a href="/properties" class="tx-btn tx-btn-primary tx-btn-sm">Browse properties</a>
          </div>
{{#else}}
          <ul class="divide-y divide-line">
{{#each r in recent}}
            <li class="px-5 py-3.5 flex items-center justify-between gap-3 hover:bg-raised">
              <div class="min-w-0">
                <p class="text-sm font-medium truncate">{{ typeLabel(r.type) }}{{ r.listing ? " · " + r.listing.title : "" }}</p>
                <p class="text-xs text-muted">{{ Fmt.ago(r.at) }}</p>
              </div>
              <span class="{{ chip(r.status) }}">{{ Fmt.label(r.status) }}</span>
            </li>
{{/each}}
          </ul>
{{/if}}
        </section>

        <section class="rounded-[18px] bg-night text-white p-5 sm:p-6">
          <span class="bb-icon-tile bb-icon-tile-sm bg-white/10 text-butter mb-4"><IconKey /></span>
          <h2 class="font-semibold mb-1">Renting through us?</h2>
          <p class="text-sm text-white/70 mb-5">Sign in to the tenant portal with your account number and phone to see your balance, download invoices and statements, and pay by M-Pesa.</p>
          <a href="/tenant" class="tx-btn tx-btn-sm bg-white !text-[#111827] hover:bg-[#E8F2FC]">Open the tenant portal <IconArrowRight class="w-4 h-4" /></a>
        </section>
      </div>
    </div>
  </div>
{{/if}}
