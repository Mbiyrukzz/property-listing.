page Login

import { IconCheck } from "tylix-icons"

title "Log in"

needs
  Auth

state
  next: "/dashboard"
  email: ""
  password: ""
  remember: false
  error: ""
  submitting: false
  perks: [
    "Save properties and get back to them anywhere",
    "Book viewings and follow your applications",
    "Get back to the listings you viewed"
  ]

action
  // Where to go after signing in: ?next=/some/path on this site, else the
  // dashboard. Only same-site paths ("/x", never "//host" or "/\host").
  readNext() {
    const wanted = new URLSearchParams(window.location.search).get("next") ?? ""
    if wanted.startsWith("/") and not wanted.startsWith("//") and not wanted.startsWith("/\\") {
      this.next = wanted
    }
  }

  setField(field, value) {
    this[field] = value
  }

  toggleRemember() {
    this.remember = not this.remember
  }

  validate() {
    if not /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email) {
      return "Enter a valid email address."
    }
    if this.password.length is 0 {
      return "Enter your password."
    }
    return ""
  }

  messageFor(result) {
    switch result.status {
      case 401, 403 {
        return "Invalid email or password."
      }
      case 422 {
        const errors = result.data?.errors
        if errors {
          const firstField = Object.keys(errors)[0]
          return errors[firstField][0]
        }
        return "Check your details and try again."
      }
      case 429 {
        return "Too many attempts. Wait a minute and try again."
      }
      default {
        return result.error ?? "Could not log in. Try again."
      }
    }
  }

  async submit() {
    if this.submitting {
      return null
    }

    this.error = this.validate()
    if this.error {
      return null
    }

    this.submitting = true
    let succeeded = false

    try {
      const result = await Auth.login(this.email, this.password)

      if result.ok {
        succeeded = true
        window.location.href = this.next
      } else {
        this.error = this.messageFor(result)
      }
    } catch (err) {
      this.error = "Network error. Check your connection and try again."
    } finally {
      if not succeeded {
        this.submitting = false
      }
    }
  }

onMount
  {
    this.readNext()
    if Auth.user {
      window.location.href = this.next
    }
  }

template
  <div class="flex items-center justify-center px-3 sm:px-6 py-6 sm:py-16">
    <div class="tx-auth tx-glow">

      <div class="tx-auth-aside">
        <p class="tx-eyebrow mb-5">Barani Better Homes</p>
        <h2 class="text-3xl font-bold tracking-tight mb-3">Welcome back</h2>
        <p class="text-sm text-muted mb-8 leading-relaxed">Your saved homes, viewings and rent, all in one place.</p>
        <ul class="space-y-3">
{{#each perk in perks}}
          <li class="flex items-start gap-2.5 text-sm text-soft">
            <span class="w-5 h-5 rounded-full bg-white/10 flex items-center justify-center shrink-0"><IconCheck class="w-3 h-3" /></span>
            {{ perk }}
          </li>
{{/each}}
        </ul>
      </div>

      <div class="tx-auth-form">
        <div class="w-full max-w-sm">
          <h1 class="text-2xl font-bold tracking-tight mb-1">Log in</h1>
          <p class="text-sm text-muted mb-8">Pick up where you left off.</p>

{{#if error}}
          <div role="alert" aria-live="polite" class="tx-alert tx-alert-error mb-6">
            <p class="text-sm">{{ error }}</p>
          </div>
{{/if}}

          <label for="email" class="tx-label">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            autofocus
            placeholder="you@example.com"
            value="{{ email }}"
            oninput="{{ setField('email', event.target.value) }}"
            onkeydown="{{ event.key is 'Enter' and submit() }}"
            class="tx-input"
          />

          <label for="password" class="tx-label">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••"
            value="{{ password }}"
            oninput="{{ setField('password', event.target.value) }}"
            onkeydown="{{ event.key is 'Enter' and submit() }}"
            class="tx-input"
          />

          <div class="flex items-center justify-between mb-6">
            <label class="flex items-center gap-2 text-sm text-muted">
              <input
                type="checkbox"
                checked="{{ remember }}"
                onclick="{{ toggleRemember() }}"
                class="tx-check rounded"
              />
              Remember me
            </label>
            <a href="/forgot-password" class="text-sm tx-link">Forgot password?</a>
          </div>

          <button
            onclick="{{ submit() }}"
            disabled="{{ submitting }}"
            class="tx-btn tx-btn-primary tx-btn-block"
          >
            {{ submitting ? 'Logging in…' : 'Log in' }}
          </button>

          <p class="text-sm text-muted text-center mt-6">
            Need an account? <a href="{{ next is '/dashboard' ? '/register' : '/register?next=' + encodeURIComponent(next) }}" class="tx-link">Sign up</a>
          </p>
          <p class="text-sm text-muted text-center mt-2">
            Renting through us? <a href="/tenant" class="tx-link">Sign in to the tenant portal</a> with your account number, no account needed.
          </p>
        </div>
      </div>
    </div>
  </div>