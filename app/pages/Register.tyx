page Register

import { IconCheck } from "tylix-icons"

title "Create account"

needs
  Auth

state
  next: "/dashboard"
  name: ""
  email: ""
  password: ""
  confirmPassword: ""
  agreedToTerms: false
  error: ""
  submitting: false
  registered: false
  emailSent: true
  resending: false
  resendNote: ""
  perks: [
    "Save properties you like",
    "Book viewings and apply online",
    "Tenant portal for balances, receipts and rent payments"
  ]

computed
  passwordsMatch() {
    return this.password is this.confirmPassword
  }

  passwordScore() {
    if this.password.length < 8 {
      return 0
    }

    const hasMixedCase = /[a-z]/.test(this.password) and /[A-Z]/.test(this.password)
    const hasDigit = /[0-9]/.test(this.password)
    const hasSymbol = /[^A-Za-z0-9]/.test(this.password)

    let score = 1
    if hasMixedCase {
      score += 1
    }
    if hasDigit {
      score += 1
    }
    if hasSymbol {
      score += 1
    }
    return score
  }

action
  async resend() {
    this.resending = true
    this.resendNote = ""
    try {
      const result = await useApi("/api/auth/resend-verification", {
        method: "POST",
        body: { email: this.email }
      })
      this.resendNote = result.ok ? "Sent. Check your inbox (and spam) in a minute or two." : (result.error ?? "Couldn't resend just now. Try again shortly.")
    } catch (err) {
      this.resendNote = "Network error. Check your connection and try again."
    } finally {
      this.resending = false
    }
  }

  // Where to go after signing in: ?next=/some/path on this site, else the
  // dashboard. Only same-site paths ("/x", never "//host" or "/\host").
  readNext() {
    const wanted = new URLSearchParams(window.location.search).get("next") ?? ""
    if wanted.startsWith("/") and not wanted.startsWith("//") and not wanted.startsWith("/\\") {
      this.next = wanted
    }
  }

  setField(field, value) {
    this[field] = value
  }

  toggleTerms() {
    this.agreedToTerms = not this.agreedToTerms
  }

  validate() {
    const emailOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email)

    if this.name.trim().length is 0 {
      return "Enter your name."
    }
    if not emailOk {
      return "Enter a valid email address."
    }
    if this.password.length < 8 {
      return "Password must be at least 8 characters."
    }
    if not this.passwordsMatch {
      return "Passwords don't match."
    }
    if not this.agreedToTerms {
      return "Please agree to the Terms of Service to continue."
    }
    return ""
  }

  messageFor(result) {
    switch result.status {
      case 409 {
        return "An account with this email already exists."
      }
      case 422 {
        const errors = result.data?.errors
        if errors {
          const firstField = Object.keys(errors)[0]
          return errors[firstField][0]
        }
        return "Check your details and try again."
      }
      case 429 {
        return "Too many attempts. Wait a minute and try again."
      }
      default {
        return result.error ?? "Could not create account. Check your details and try again."
      }
    }
  }

  async submit() {
    if this.submitting {
      return null
    }

    this.error = this.validate()
    if this.error {
      return null
    }

    this.submitting = true

    try {
      const result = await useApi("/api/register", {
        method: "POST",
        body: { name: this.name, email: this.email, password: this.password }
      })

      if result.ok {
        this.registered = true
        this.emailSent = result.data?.emailSent is not false
      } else {
        this.error = this.messageFor(result)
      }
    } catch (err) {
      this.error = "Network error. Check your connection and try again."
    } finally {
      this.submitting = false
    }
  }

onMount
  {
    this.readNext()
    if Auth.user {
      window.location.href = this.next
    }
  }

template
  <div class="flex items-center justify-center px-3 sm:px-6 py-6 sm:py-16">
    <div class="tx-auth tx-glow">

      <div class="tx-auth-aside">
        <p class="tx-eyebrow mb-5">New account</p>
        <h2 class="text-3xl font-bold tracking-tight mb-3">Your next home starts here</h2>
        <p class="text-sm text-muted mb-8 leading-relaxed">One account for house hunting, viewings and your tenancy.</p>
        <ul class="space-y-3">
{{#each perk in perks}}
          <li class="flex items-start gap-2.5 text-sm text-soft">
            <span class="w-5 h-5 rounded-full bg-white/10 flex items-center justify-center shrink-0"><IconCheck class="w-3 h-3" /></span>
            {{ perk }}
          </li>
{{/each}}
        </ul>
      </div>

      <div class="tx-auth-form">
        <div class="w-full max-w-sm">
{{#if registered}}
          <div class="w-11 h-11 rounded-lg bg-brand/10 flex items-center justify-center mb-5">
            <IconCheck class="w-5 h-5 text-link" />
          </div>
          <h1 class="text-2xl font-bold tracking-tight mb-2">{{ emailSent ? "Check your email" : "Account created" }}</h1>
{{#if emailSent}}
          <p class="text-sm text-muted mb-8">
            We sent a verification link to <span class="text-ink">{{ email }}</span>.
            Click it, then log in.
          </p>
{{#else}}
          <p class="text-sm text-muted mb-4">
            Your account is ready, but the verification email to <span class="text-ink">{{ email }}</span> didn't go out. Try sending it again in a minute.
          </p>
          <button type="button" class="tx-btn tx-btn-outline tx-btn-block mb-3" disabled="{{ resending }}" onclick="{{ resend() }}">{{ resending ? "Sending…" : "Resend verification email" }}</button>
{{#if resendNote}}
          <p class="text-sm text-muted mb-5" aria-live="polite">{{ resendNote }}</p>
{{/if}}
{{/if}}
          <a href="/login" class="tx-btn tx-btn-primary tx-btn-block">
            Go to login
          </a>
{{#else}}
          <h1 class="text-2xl font-bold tracking-tight mb-1">Create your account</h1>
          <p class="text-sm text-muted mb-8">Save properties, book viewings and follow your applications in one place.</p>

{{#if error}}
          <div role="alert" aria-live="polite" class="tx-alert tx-alert-error mb-6">
            <p class="text-sm">{{ error }}</p>
          </div>
{{/if}}

          <label for="name" class="tx-label">Name</label>
          <input
            id="name"
            name="name"
            autocomplete="name"
            autofocus
            placeholder="Jane Doe"
            value="{{ name }}"
            oninput="{{ setField('name', event.target.value) }}"
            class="tx-input"
          />

          <label for="email" class="tx-label">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            value="{{ email }}"
            oninput="{{ setField('email', event.target.value) }}"
            class="tx-input"
          />

          <label for="password" class="tx-label">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            placeholder="••••••••"
            value="{{ password }}"
            oninput="{{ setField('password', event.target.value) }}"
            class="tx-input mb-2"
          />

{{#if password.length > 0}}
          <div class="flex gap-1.5 mb-1.5">
{{#each n in [0, 1, 2, 3]}}
            <div class="{{ 'h-1 flex-1 rounded-full transition-colors ' + (n < passwordScore ? 'bg-brand' : 'bg-line ') }}"></div>
{{/each}}
          </div>
          <p class="text-muted text-xs mb-4">{{ ['Too short', 'Weak', 'Okay', 'Good', 'Strong'][passwordScore] }}</p>
{{#else}}
          <p class="text-muted text-xs mb-4">At least 8 characters.</p>
{{/if}}

          <label for="confirmPassword" class="tx-label">Confirm password</label>
          <input
            id="confirmPassword"
            name="confirmPassword"
            type="password"
            autocomplete="new-password"
            placeholder="••••••••"
            value="{{ confirmPassword }}"
            oninput="{{ setField('confirmPassword', event.target.value) }}"
            onkeydown="{{ event.key is 'Enter' and submit() }}"
            class="tx-input mb-2"
          />
{{#if confirmPassword.length > 0 and not passwordsMatch}}
          <p class="text-coral text-xs mb-3">Passwords don't match.</p>
{{/if}}

          <label class="flex items-start gap-2.5 text-sm text-muted my-5">
            <input
              type="checkbox"
              checked="{{ agreedToTerms }}"
              onclick="{{ toggleTerms() }}"
              class="mt-0.5 rounded border-line-strong bg-canvas text-mint focus:ring-aqua"
            />
            <span>
              I agree to the
              <a href="https://tylix.dev/terms" class="tx-link">Terms of Service</a>
              and
              <a href="https://tylix.dev/privacy" class="tx-link">Privacy Policy</a>.
            </span>
          </label>

          <button
            onclick="{{ submit() }}"
            disabled="{{ submitting }}"
            class="tx-btn tx-btn-primary tx-btn-block"
          >
            {{ submitting ? 'Creating account…' : 'Sign up' }}
          </button>

          <p class="text-sm text-muted text-center mt-6">
            Already have an account? <a href="{{ next is '/dashboard' ? '/login' : '/login?next=' + encodeURIComponent(next) }}" class="tx-link">Log in</a>
          </p>
{{/if}}
        </div>
      </div>
    </div>
  </div>