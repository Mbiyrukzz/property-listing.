page AccountProfile

import AccountNav from "../components/AccountNav"

title "Profile | Barani Better Homes"

needs
  Auth

uses
  Fmt

state
  form: { name: "", phone: "", preferredContact: "phone", lookingFor: "", preferredLocation: "", budgetMax: "" }
  email: ""
  loading: true
  saving: false
  errors: {}
  notice: ""
  formError: ""

action
  fieldError(field) {
    const list = this.errors[field]
    return Array.isArray(list) and list.length > 0 ? list[0] : ""
  }

  async save() {
    this.saving = true
    this.errors = {}
    this.notice = ""
    this.formError = ""
    const result = await useApi("/api/account/profile", { method: "PUT", body: this.form })
    this.saving = false
    if result.ok {
      this.notice = "Saved."
      Auth.user = { ...Auth.user, name: result.data.data.name }
      return null
    }
    if result.status is 422 {
      this.errors = result.data.errors ?? {}
      return null
    }
    this.formError = Fmt.firstError(result)
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login?next=/account/profile"
      return null
    }
    const result = await useApi("/api/account/profile")
    if result.ok {
      const p = result.data.data
      this.email = p.email
      this.form = {
        name: p.name, phone: p.phone, preferredContact: p.preferredContact, lookingFor: p.lookingFor,
        preferredLocation: p.preferredLocation, budgetMax: p.budgetMax ?? ""
      }
    }
    this.loading = false
  }

template
{{#if Auth.user}}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-8 grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-4 lg:gap-8">
    <AccountNav current="profile" />
    <div class="min-w-0 max-w-xl">
      <h1 class="text-2xl font-bold tracking-tight mb-6">Profile</h1>
{{#if loading}}
      <p class="text-sm text-muted">Loading…</p>
{{#else}}
      <form class="tx-panel p-5" onsubmit.prevent="{{ save() }}" novalidate>
{{#if notice}}<div class="tx-alert tx-alert-success mb-4" role="status"><p class="text-sm">{{ notice }}</p></div>{{/if}}
{{#if formError}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p class="text-sm">{{ formError }}</p></div>{{/if}}

        <label class="tx-label" for="pf-name">Name</label>
        <input id="pf-name" class="tx-input" autocomplete="name" bind:value="{{ form.name }}" aria-invalid="{{ fieldError('name') ? 'true' : 'false' }}" />
{{#if fieldError("name")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("name") }}</p>{{/if}}

        <label class="tx-label" for="pf-email">Email</label>
        <input id="pf-email" class="tx-input" value="{{ email }}" disabled />

        <label class="tx-label" for="pf-phone">Phone</label>
        <input id="pf-phone" class="tx-input" type="tel" autocomplete="tel" placeholder="0712 345 678" bind:value="{{ form.phone }}" aria-invalid="{{ fieldError('phone') ? 'true' : 'false' }}" />
{{#if fieldError("phone")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("phone") }}</p>{{/if}}

        <label class="tx-label" for="pf-contact">Best way to reach you</label>
        <select id="pf-contact" class="tx-input" bind:value="{{ form.preferredContact }}">
          <option value="phone">Phone call</option>
          <option value="whatsapp">WhatsApp</option>
          <option value="email">Email</option>
        </select>

        <h2 class="font-semibold mt-2 mb-3">What are you looking for?</h2>
        <div class="grid sm:grid-cols-2 gap-x-4">
          <div>
            <label class="tx-label" for="pf-looking">I want to</label>
            <select id="pf-looking" class="tx-input" bind:value="{{ form.lookingFor }}">
              <option value="">Not sure yet</option>
              <option value="rent">Rent a home</option>
              <option value="buy">Buy a home</option>
              <option value="land">Buy land</option>
              <option value="commercial">Find an office or shop</option>
            </select>
          </div>
          <div>
            <label class="tx-label" for="pf-budget">Budget up to (KES)</label>
            <input id="pf-budget" class="tx-input" type="number" min="0" step="1000" bind:value="{{ form.budgetMax }}" />
          </div>
        </div>
        <label class="tx-label" for="pf-location">Preferred area</label>
        <input id="pf-location" class="tx-input" placeholder="e.g. Nyali, Kilimani" bind:value="{{ form.preferredLocation }}" />

        <button type="submit" class="tx-btn tx-btn-primary" disabled="{{ saving }}">{{ saving ? "Saving…" : "Save profile" }}</button>
        <p class="text-sm text-muted mt-4">Need to change your password? <a class="tx-link" href="/forgot-password">Reset it by email</a>.</p>
      </form>
{{/if}}
    </div>
  </div>
{{/if}}
