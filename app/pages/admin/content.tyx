page AdminContent

import AdminNav from "../components/AdminNav"
import { IconPlus, IconExternalLink, IconTrash, IconDocumentText } from "tylix-icons"

title "Content & settings | Barani Better Homes admin"

needs
  Auth

permissions
  content.manage

uses
  Site
  Fmt

state
  tab: "site"
  loading: true
  loadError: ""
  settings: {}
  pages: []
  saving: false
  notice: ""
  formError: ""
  errors: {}
  page: null
  pageSlug: ""
  pageTitle: ""
  pageBody: ""
  pagePublished: true
  isNewPage: false

action
  fieldError(field) {
    const list = this.errors[field]
    return Array.isArray(list) and list.length > 0 ? list[0] : ""
  }

  tabClass(key) {
    return "text-sm px-3 py-1.5 rounded-md " + (this.tab is key ? "bg-panel shadow font-semibold text-ink" : "text-muted")
  }

  async load() {
    const result = await useApi("/api/admin/content")
    if result.ok {
      this.settings = result.data.settings
      this.pages = result.data.pages
    } else {
      this.loadError = Fmt.firstError(result)
    }
    this.loading = false
  }

  async saveSettings() {
    this.saving = true
    this.errors = {}
    this.notice = ""
    this.formError = ""
    const result = await useApi("/api/admin/settings", { method: "PUT", body: this.settings })
    this.saving = false
    if result.ok {
      this.settings = result.data.settings
      this.notice = "Saved. The site shows the new details now."
      await Site.reload()
      return null
    }
    if result.status is 422 and result.data and result.data.errors {
      this.errors = result.data.errors
      return null
    }
    this.formError = Fmt.firstError(result)
  }

  editPage(p) {
    this.notice = ""
    this.formError = ""
    this.errors = {}
    this.isNewPage = false
    this.page = p
    this.pageSlug = p.slug
    this.pageTitle = p.title
    this.pageBody = p.body
    this.pagePublished = p.isPublished
  }

  newPage() {
    this.notice = ""
    this.formError = ""
    this.errors = {}
    this.isNewPage = true
    this.page = { slug: "" }
    this.pageSlug = ""
    this.pageTitle = ""
    this.pageBody = ""
    this.pagePublished = true
  }

  slugFor(text) {
    return String(text).toLowerCase().normalize("NFKD").replace(/[^\w\s-]/g, "").trim().replace(/[\s_]+/g, "-").replace(/-+/g, "-").slice(0, 80)
  }

  async savePage() {
    const slug = this.isNewPage ? this.slugFor(this.pageSlug or this.pageTitle) : this.pageSlug
    if not slug {
      this.errors = { title: ["Give the page a title."] }
      return null
    }
    if this.isNewPage and this.pages.some(p => p.slug is slug) {
      this.errors = { slug: ["A page already uses /p/" + slug + ". Pick another address."] }
      return null
    }
    this.saving = true
    this.errors = {}
    this.formError = ""
    const result = await useApi(`/api/admin/pages/${slug}`, { method: "PUT", body: { title: this.pageTitle, body: this.pageBody, isPublished: this.pagePublished } })
    this.saving = false
    if result.ok {
      this.notice = "Page saved at /p/" + result.data.data.slug + "."
      this.page = null
      await this.load()
      await Site.reload()
      return null
    }
    if result.status is 422 and result.data and result.data.errors {
      this.errors = result.data.errors
      return null
    }
    this.formError = Fmt.firstError(result)
  }

  async deletePage() {
    if not confirm("Delete the page /p/" + this.pageSlug + "? Links to it will stop working.") {
      return null
    }
    const result = await useApi(`/api/admin/pages/${this.pageSlug}`, { method: "DELETE" })
    if result.ok {
      this.notice = "Page deleted."
      this.page = null
      await this.load()
      await Site.reload()
      return null
    }
    this.formError = Fmt.firstError(result)
  }

onMount
  async {
    if new URLSearchParams(window.location.search).get("tab") is "pages" {
      this.tab = "pages"
    }
    await this.load()
  }

template
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-8 grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-4 lg:gap-8">
    <AdminNav current="content" />

    <div class="min-w-0">
      <h1 class="text-2xl font-bold tracking-tight">Content & settings</h1>
      <p class="text-sm text-muted mt-1 mb-6">Homepage wording, contact details and the site's information pages. News articles are written under <a class="tx-link" href="/posts">News</a>.</p>

      <div class="inline-flex gap-1 p-1 rounded-lg bg-raised mb-5" role="tablist">
        <button role="tab" aria-selected="{{ tab is 'site' }}" class="{{ tabClass('site') }}" onclick="{{ tab = 'site' }}">Homepage & contact</button>
        <button role="tab" aria-selected="{{ tab is 'pages' }}" class="{{ tabClass('pages') }}" onclick="{{ tab = 'pages' }}">Pages ({{ pages.length }})</button>
      </div>

{{#if notice}}<div class="tx-alert tx-alert-success mb-4" role="status"><p class="text-sm">{{ notice }}</p></div>{{/if}}
{{#if formError}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p class="text-sm">{{ formError }}</p></div>{{/if}}
{{#if loadError}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p class="text-sm">{{ loadError }}</p></div>{{/if}}

{{#if loading}}
      <div data-page-loader="true" class="text-sm text-muted">Loading…</div>
{{#else if tab is "site"}}
      <form class="grid grid-cols-1 xl:grid-cols-2 gap-6 items-start" onsubmit.prevent="{{ saveSettings() }}" novalidate>
        <section class="tx-panel p-5">
          <h2 class="font-semibold mb-4">Homepage</h2>
          <label class="tx-label" for="st-name">Site name</label>
          <input id="st-name" class="tx-input" maxlength="60" bind:value="{{ settings.site_name }}" />
          <label class="tx-label" for="st-tagline">Tagline</label>
          <input id="st-tagline" class="tx-input" maxlength="160" bind:value="{{ settings.tagline }}" />
          <label class="tx-label" for="st-hero">Headline</label>
          <input id="st-hero" class="tx-input" maxlength="120" bind:value="{{ settings.hero_title }}" />
          <label class="tx-label" for="st-sub">Text under the headline</label>
          <textarea id="st-sub" class="tx-input" rows="3" maxlength="300" bind:value="{{ settings.hero_subtitle }}"></textarea>
          <label class="tx-label" for="st-about">Footer blurb</label>
          <textarea id="st-about" class="tx-input" rows="3" maxlength="300" bind:value="{{ settings.about_short }}"></textarea>
        </section>

        <section class="tx-panel p-5">
          <h2 class="font-semibold mb-4">Contact details</h2>
          <p class="text-xs text-muted -mt-2 mb-4">Shown in the footer, on the contact page, and on listings without an agent.</p>
          <div class="grid sm:grid-cols-2 gap-x-4">
            <div>
              <label class="tx-label" for="st-phone">Office phone</label>
              <input id="st-phone" class="tx-input" type="tel" placeholder="0712 345 678" bind:value="{{ settings.phone }}" />
            </div>
            <div>
              <label class="tx-label" for="st-wa">WhatsApp</label>
              <input id="st-wa" class="tx-input" type="tel" bind:value="{{ settings.whatsapp }}" />
            </div>
          </div>
          <label class="tx-label" for="st-email">Email</label>
          <input id="st-email" class="tx-input" type="email" bind:value="{{ settings.email }}" aria-invalid="{{ fieldError('email') ? 'true' : 'false' }}" />
{{#if fieldError("email")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("email") }}</p>{{/if}}
          <label class="tx-label" for="st-address">Office address</label>
          <input id="st-address" class="tx-input" bind:value="{{ settings.address }}" />
          <label class="tx-label" for="st-hours">Office hours</label>
          <input id="st-hours" class="tx-input" bind:value="{{ settings.office_hours }}" />
          <div class="grid sm:grid-cols-2 gap-x-4">
            <div>
              <label class="tx-label" for="st-fb">Facebook link</label>
              <input id="st-fb" class="tx-input" placeholder="https://facebook.com/…" bind:value="{{ settings.facebook }}" />
            </div>
            <div>
              <label class="tx-label" for="st-ig">Instagram link</label>
              <input id="st-ig" class="tx-input" placeholder="https://instagram.com/…" bind:value="{{ settings.instagram }}" />
            </div>
          </div>
        </section>

        <div class="xl:col-span-2">
          <button type="submit" class="tx-btn tx-btn-primary" disabled="{{ saving }}">{{ saving ? "Saving…" : "Save settings" }}</button>
        </div>
      </form>
{{#else if page}}
      <form class="tx-panel p-5 max-w-3xl" onsubmit.prevent="{{ savePage() }}" novalidate>
        <h2 class="font-semibold mb-4">{{ isNewPage ? "New page" : "Edit page" }}</h2>
        <label class="tx-label" for="pg-title">Title</label>
        <input id="pg-title" class="tx-input" maxlength="200" bind:value="{{ pageTitle }}" aria-invalid="{{ fieldError('title') ? 'true' : 'false' }}" />
{{#if fieldError("title")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("title") }}</p>{{/if}}
{{#if isNewPage}}
        <label class="tx-label" for="pg-slug">Address</label>
        <div class="flex items-center gap-2">
          <span class="text-sm text-muted mb-4">/p/</span>
          <input id="pg-slug" class="tx-input" placeholder="{{ slugFor(pageTitle) or 'faq' }}" bind:value="{{ pageSlug }}" aria-invalid="{{ fieldError('slug') ? 'true' : 'false' }}" />
        </div>
{{#if fieldError("slug")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("slug") }}</p>{{/if}}
{{#else}}
        <p class="text-sm text-muted -mt-2 mb-4">At <a class="tx-link" href="/p/{{ pageSlug }}" target="_blank" rel="noopener">/p/{{ pageSlug }}</a></p>
{{/if}}
        <label class="tx-label" for="pg-body">Text</label>
        <textarea id="pg-body" class="tx-input font-mono text-sm" rows="14" bind:value="{{ pageBody }}"></textarea>
        <p class="text-xs text-muted -mt-3 mb-4">Plain text. A blank line starts a new paragraph.</p>
        <label class="flex items-center gap-2 text-sm mb-4"><input type="checkbox" bind:checked="{{ pagePublished }}" /> Published (linked from the footer)</label>
        <div class="flex flex-wrap gap-2">
          <button type="submit" class="tx-btn tx-btn-primary tx-btn-sm" disabled="{{ saving }}">{{ saving ? "Saving…" : "Save page" }}</button>
          <button type="button" class="tx-btn tx-btn-ghost tx-btn-sm" onclick="{{ page = null }}">Cancel</button>
{{#if not isNewPage}}
          <button type="button" class="tx-btn tx-btn-ghost tx-btn-sm text-coral ml-auto" onclick="{{ deletePage() }}"><IconTrash class="w-4 h-4" /> Delete</button>
{{/if}}
        </div>
      </form>
{{#else}}
      <div class="flex justify-end mb-3">
        <button class="tx-btn tx-btn-primary tx-btn-sm" onclick="{{ newPage() }}"><IconPlus class="w-4 h-4" /> New page</button>
      </div>
{{#if pages.length is 0}}
      <div class="tx-panel p-8 text-center">
        <IconDocumentText class="w-6 h-6 text-muted mx-auto mb-3" />
        <p class="text-sm text-muted">No pages yet.</p>
      </div>
{{#else}}
      <ul class="tx-panel divide-y divide-line">
{{#each p in pages}}
        <li class="p-4 flex flex-wrap items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="font-medium">{{ p.title }}</p>
            <p class="text-xs text-muted">/p/{{ p.slug }} · updated {{ Fmt.ago(p.updatedAt) }}</p>
          </div>
          <div class="flex items-center gap-2">
{{#if not p.isPublished}}<span class="bb-chip bb-chip-muted">Hidden</span>{{/if}}
            <a class="tx-btn tx-btn-ghost tx-btn-sm" href="/p/{{ p.slug }}" target="_blank" rel="noopener" aria-label="Open {{ p.title }}"><IconExternalLink class="w-4 h-4" /></a>
            <button class="tx-btn tx-btn-outline tx-btn-sm" onclick="{{ editPage(p) }}">Edit</button>
          </div>
        </li>
{{/each}}
      </ul>
{{/if}}
{{/if}}
    </div>
  </div>
