page AdminCustomers

import AdminNav from "../components/AdminNav"
import { IconSearch, IconUsers, IconCheckCircle } from "tylix-icons"

title "Customers | Barani Better Homes admin"

needs
  Auth

permissions
  customers.view

uses
  Fmt

state
  rows: []
  q: ""
  loading: true
  loadError: ""

action
  lookingLabel(v) {
    if v is "rent" {
      return "Renting"
    }
    if v is "buy" {
      return "Buying a home"
    }
    if v is "land" {
      return "Buying land"
    }
    if v is "commercial" {
      return "Office or shop"
    }
    return "—"
  }

  async load() {
    this.loadError = ""
    const q = this.q.trim()
    const result = await useApi("/api/admin/customers" + (q ? "?q=" + encodeURIComponent(q) : ""))
    if result.ok {
      this.rows = result.data.data
    } else {
      this.loadError = Fmt.firstError(result)
    }
    this.loading = false
  }

onMount
  async {
    await this.load()
  }

template
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-8 grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-4 lg:gap-8">
    <AdminNav current="customers" />

    <div class="min-w-0">
      <h1 class="text-2xl font-bold tracking-tight">Customers</h1>
      <p class="text-sm text-muted mt-1 mb-6">Everyone with a Barani Better Homes account, newest first.{{#if can("roles.manage")}} Give staff their role on <a class="tx-link" href="/admin/access">Roles &amp; access</a>.{{/if}}</p>

      <form class="relative mb-4 max-w-md" onsubmit.prevent="{{ load() }}">
        <IconSearch class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none" />
        <input class="tx-input !mb-0 pl-9" type="search" placeholder="Name or email, then Enter" aria-label="Search customers" bind:value="{{ q }}" />
      </form>

{{#if loadError}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p class="text-sm">{{ loadError }}</p></div>{{/if}}

{{#if loading}}
      <div data-page-loader="true" class="text-sm text-muted">Loading…</div>
{{#else if rows.length is 0}}
      <div class="tx-panel p-8 text-center">
        <IconUsers class="w-6 h-6 text-muted mx-auto mb-3" />
        <p class="text-sm text-muted">{{ q ? "Nobody matches that search." : "No customer accounts yet." }}</p>
      </div>
{{#else}}
      <p class="text-xs text-muted mb-2">{{ rows.length }} {{ rows.length is 1 ? "account" : "accounts" }}{{ rows.length >= 300 ? " (first 300; search to narrow)" : "" }}</p>
      <div class="tx-panel overflow-x-auto">
        <table class="bb-table">
          <thead>
            <tr><th>Customer</th><th>Phone</th><th>Looking for</th><th>Saved</th><th>Enquiries</th><th>Applications</th><th>Joined</th></tr>
          </thead>
          <tbody>
{{#each c in rows}}
            <tr>
              <td class="min-w-[14rem]">
                <p class="font-medium flex items-center gap-1.5">{{ c.name }}</p>
                <p class="text-xs text-muted flex items-center gap-1 break-all">{{ c.email }}{{#if c.verified}} <IconCheckCircle class="w-3.5 h-3.5 text-brand shrink-0" aria-label="Email confirmed" />{{/if}}</p>
              </td>
              <td class="whitespace-nowrap">{{ c.phone or "—" }}</td>
              <td class="whitespace-nowrap">{{ lookingLabel(c.lookingFor) }}</td>
              <td>{{ c.saved }}</td>
              <td>{{ c.enquiries }}</td>
              <td>{{ c.applications }}</td>
              <td class="whitespace-nowrap text-xs text-muted">{{ Fmt.date(c.createdAt) }}</td>
            </tr>
{{/each}}
          </tbody>
        </table>
      </div>
{{/if}}
    </div>
  </div>
