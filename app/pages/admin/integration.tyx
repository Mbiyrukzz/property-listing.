page AdminIntegration

import AdminNav from "../components/AdminNav"
import { IconRefresh, IconCheckCircle, IconExclamationTriangle, IconPlug, IconClock } from "tylix-icons"

title "HQ sync | Barani Better Homes admin"

needs
  Auth

permissions
  integration.view

uses
  Fmt

state
  loading: true
  loadError: ""
  info: null
  syncing: false
  outcome: null
  syncError: ""
  onlyErrors: false

computed
  logs() {
    if not this.info {
      return []
    }
    return this.onlyErrors ? this.info.logs.filter(l => l.status is "error") : this.info.logs
  }

  healthy() {
    return this.info and this.info.configured and not (this.info.lastFull and this.info.lastFull.status is "error")
  }

action
  chip(status) {
    if status is "ok" {
      return "bb-chip bb-chip-ok"
    }
    if status is "error" {
      return "bb-chip bb-chip-bad"
    }
    return "bb-chip bb-chip-muted"
  }

  eventLabel(log) {
    if log.event is "full" {
      return "Full sync"
    }
    return Fmt.label(String(log.event).replace(".", " ")) + (log.externalId ? " #" + log.externalId : "")
  }

  async load() {
    const result = await useApi("/api/admin/integration")
    if result.ok {
      this.info = result.data
    } else {
      this.loadError = Fmt.firstError(result)
    }
    this.loading = false
  }

  async syncNow() {
    this.syncing = true
    this.outcome = null
    this.syncError = ""
    const result = await useApi("/api/admin/integration/sync", { method: "POST" })
    this.syncing = false
    if result.ok {
      this.outcome = result.data.outcome
    } else {
      this.syncError = result.data and result.data.outcome ? result.data.outcome.message : Fmt.firstError(result)
    }
    await this.load()
  }

onMount
  async {
    await this.load()
  }

template
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-8 grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-4 lg:gap-8">
    <AdminNav current="integration" />

    <div class="min-w-0">
      <div class="flex flex-wrap items-end justify-between gap-3 mb-6">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">HQ sync</h1>
          <p class="text-sm text-muted mt-1">HQ sends a webhook when a published property or unit changes. A full sync also runs on a schedule to catch anything missed.</p>
        </div>
{{#if can("integration.manage") and info and info.configured}}
        <button class="tx-btn tx-btn-primary tx-btn-sm" disabled="{{ syncing }}" onclick="{{ syncNow() }}"><IconRefresh class="w-4 h-4 {{ syncing ? 'animate-spin' : '' }}" /> {{ syncing ? "Syncing…" : "Sync now" }}</button>
{{/if}}
      </div>

{{#if loadError}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p class="text-sm">{{ loadError }}</p></div>{{/if}}
{{#if outcome}}<div class="tx-alert tx-alert-success mb-4" role="status"><p class="text-sm">Sync finished: {{ outcome.upserted }} updated, {{ outcome.removed }} removed{{ outcome.message ? ". " + outcome.message : "." }}</p></div>{{/if}}
{{#if syncError}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p class="text-sm">Sync failed: {{ syncError }}</p></div>{{/if}}

{{#if loading}}
      <div data-page-loader="true" class="text-sm text-muted">Loading…</div>
{{#else if info}}
{{#if not info.configured}}
      <div class="tx-alert tx-alert-info mb-6">
        <p class="text-sm font-medium mb-1">Not connected</p>
        <p class="text-sm">Set HQ_URL, HQ_API_TOKEN and HQ_WEBHOOK_SECRET in Barani Better Homes' .env (matching BBHOMES_* in HQ's .env), then restart. See .env.example.</p>
      </div>
{{/if}}

      <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-3 mb-6">
        <div class="tx-panel p-4">
          <div class="flex items-center gap-2 mb-2">
{{#if healthy}}<IconCheckCircle class="w-4 h-4 text-brand" />{{#else}}<IconExclamationTriangle class="w-4 h-4 text-coral" />{{/if}}
            <p class="text-xs text-muted">Connection</p>
          </div>
          <p class="font-semibold">{{ info.configured ? (healthy ? "Working" : "Last sync failed") : "Not set up" }}</p>
          <p class="text-xs text-muted mt-1 break-all">{{ info.host or "No HQ_URL" }}{{ info.webhookConfigured ? " · webhooks on" : " · webhooks off" }}</p>
        </div>
        <div class="tx-panel p-4">
          <div class="flex items-center gap-2 mb-2"><IconClock class="w-4 h-4 text-brand" /><p class="text-xs text-muted">Last full sync</p></div>
          <p class="font-semibold">{{ info.lastFull ? Fmt.ago(info.lastFull.at) : "Never" }}</p>
          <p class="text-xs text-muted mt-1">Runs every {{ info.intervalMinutes }} min</p>
        </div>
        <div class="tx-panel p-4">
          <div class="flex items-center gap-2 mb-2"><IconPlug class="w-4 h-4 text-brand" /><p class="text-xs text-muted">Last webhook</p></div>
          <p class="font-semibold">{{ info.lastWebhook ? Fmt.ago(info.lastWebhook.at) : "None yet" }}</p>
          <p class="text-xs text-muted mt-1">{{ info.lastWebhook ? Fmt.label(info.lastWebhook.status) : "Sent when a listing changes" }}</p>
        </div>
        <div class="tx-panel p-4">
          <p class="text-xs text-muted mb-2">From HQ</p>
          <p class="font-semibold">{{ info.listings.published }} published of {{ info.listings.total }}</p>
          <p class="text-xs text-muted mt-1">{{ info.listings.vacantUnits }} vacant {{ info.listings.vacantUnits is 1 ? "unit" : "units" }} listed</p>
        </div>
      </div>

      <section class="tx-panel">
        <div class="flex flex-wrap items-center justify-between gap-3 p-4 border-b border-line">
          <h2 class="font-semibold">Sync log</h2>
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" bind:checked="{{ onlyErrors }}" /> Errors only</label>
        </div>
{{#if logs.length is 0}}
        <p class="p-4 text-sm text-muted">{{ onlyErrors ? "No errors in the last 60 entries." : "Nothing logged yet." }}</p>
{{#else}}
        <div class="overflow-x-auto">
          <table class="bb-table">
            <thead><tr><th>When</th><th>Event</th><th>Trigger</th><th>Result</th><th class="text-right">Changed</th><th>Message</th></tr></thead>
            <tbody>
{{#each l in logs}}
              <tr>
                <td class="whitespace-nowrap text-xs" title="{{ Fmt.dateTime(l.at) }}">{{ Fmt.ago(l.at) }}</td>
                <td class="whitespace-nowrap">{{ eventLabel(l) }}</td>
                <td class="whitespace-nowrap text-xs text-muted">{{ Fmt.label(l.trigger) }}</td>
                <td><span class="{{ chip(l.status) }}">{{ Fmt.label(l.status) }}</span></td>
                <td class="text-right tabular-nums whitespace-nowrap">{{ l.upserted ?? 0 }} / {{ l.removed ?? 0 }}{{ l.durationMs ? " · " + l.durationMs + " ms" : "" }}</td>
                <td class="text-xs text-soft min-w-[14rem]">{{ l.message or "" }}</td>
              </tr>
{{/each}}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-muted p-4 pt-2">Changed = listings updated / removed.</p>
{{/if}}
      </section>
{{/if}}
    </div>
  </div>
