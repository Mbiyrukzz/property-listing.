page AdminListings

import AdminNav from "../../components/AdminNav"
import { IconPlus, IconSearch, IconStar, IconBuildingOffice, IconPlug } from "tylix-icons"

title "Listings | Barani Better Homes admin"

needs
  Auth

permissions
  listings.view

uses
  Fmt

state
  rows: []
  loading: true
  loadError: ""
  notice: ""
  q: ""
  source: ""
  purpose: ""
  published: ""
  busyId: null

action
  readUrl() {
    const p = new URLSearchParams(window.location.search)
    this.q = p.get("q") ?? ""
    this.source = p.get("source") ?? ""
    this.purpose = p.get("purpose") ?? ""
    this.published = p.get("published") ?? ""
    if p.get("deleted") {
      this.notice = "Listing deleted."
    }
  }

  query() {
    const p = new URLSearchParams()
    if this.q.trim() {
      p.set("q", this.q.trim())
    }
    if this.source {
      p.set("source", this.source)
    }
    if this.purpose {
      p.set("purpose", this.purpose)
    }
    if this.published {
      p.set("published", this.published)
    }
    return p.toString()
  }

  // onchange runs before bind:value updates, so take the value from the event.
  async filterBy(field, value) {
    if field is "source" {
      this.source = value
    } else if field is "purpose" {
      this.purpose = value
    } else if field is "published" {
      this.published = value
    }
    await this.load()
  }

  async load() {
    this.loading = true
    this.loadError = ""
    const qs = this.query()
    window.history.replaceState(null, "", "/admin/listings" + (qs ? "?" + qs : ""))
    const result = await useApi("/api/admin/listings" + (qs ? "?" + qs : ""))
    if result.ok {
      this.rows = result.data.data
    } else {
      this.loadError = Fmt.firstError(result)
    }
    this.loading = false
  }

  async toggleFeatured(row) {
    this.busyId = row.id
    const result = await useApi(`/api/admin/listings/${row.id}`, { method: "PUT", body: { is_featured: not row.isFeatured } })
    this.busyId = null
    if result.ok {
      this.rows = this.rows.map(r => r.id is row.id ? result.data.data : r)
      this.notice = result.data.data.isFeatured ? "Featured on the homepage." : "Removed from featured."
    } else {
      this.notice = Fmt.firstError(result)
    }
  }

onMount
  async {
    this.readUrl()
    await this.load()
  }

template
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-8 grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-4 lg:gap-8">
    <AdminNav current="listings" />

    <div class="min-w-0">
      <div class="flex flex-wrap items-end justify-between gap-3 mb-6">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">Listings</h1>
          <p class="text-sm text-muted mt-1">Rentals come from HQ. Sales, land and other Website-only listings are added here.</p>
        </div>
{{#if can("listings.manage")}}
        <a href="/admin/listings/new" class="tx-btn tx-btn-primary tx-btn-sm"><IconPlus class="w-4 h-4" /> New listing</a>
{{/if}}
      </div>

      <form class="tx-panel p-3 mb-4 flex flex-wrap gap-2 items-center" onsubmit.prevent="{{ load() }}">
        <div class="relative flex-1 min-w-[12rem]">
          <IconSearch class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none" />
          <input class="tx-input !mb-0 pl-9" type="search" placeholder="Title, area, description" aria-label="Search listings" bind:value="{{ q }}" />
        </div>
        <select class="tx-input !mb-0 !w-auto" aria-label="Source" bind:value="{{ source }}" onchange="{{ filterBy('source', $event.target.value) }}">
          <option value="">All sources</option>
          <option value="properman">From HQ</option>
          <option value="manual">Website-only</option>
        </select>
        <select class="tx-input !mb-0 !w-auto" aria-label="Purpose" bind:value="{{ purpose }}" onchange="{{ filterBy('purpose', $event.target.value) }}">
          <option value="">Rent & sale</option>
          <option value="rent">For rent</option>
          <option value="sale">For sale</option>
        </select>
        <select class="tx-input !mb-0 !w-auto" aria-label="Published" bind:value="{{ published }}" onchange="{{ filterBy('published', $event.target.value) }}">
          <option value="">Published or not</option>
          <option value="1">Published</option>
          <option value="0">Not published</option>
        </select>
        <button type="submit" class="tx-btn tx-btn-outline tx-btn-sm">Search</button>
      </form>

{{#if notice}}<div class="tx-alert tx-alert-info mb-4" role="status"><p class="text-sm">{{ notice }}</p></div>{{/if}}
{{#if loadError}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p class="text-sm">{{ loadError }}</p></div>{{/if}}

{{#if loading}}
      <div data-page-loader="true" class="text-sm text-muted">Loading…</div>
{{#else if rows.length is 0}}
      <div class="tx-panel p-8 text-center">
        <IconBuildingOffice class="w-6 h-6 text-muted mx-auto mb-3" />
        <p class="text-sm text-muted">No listings match. Publish a property in HQ, or add a sale or land listing here.</p>
      </div>
{{#else}}
      <p class="text-xs text-muted mb-2">{{ rows.length }} {{ rows.length is 1 ? "listing" : "listings" }}</p>
      <div class="tx-panel overflow-x-auto relative">
        <table class="bb-table">
          <thead>
            <tr><th>Listing</th><th>Price</th><th>Units</th><th>Status</th><th>Updated</th><th><span class="sr-only">Featured</span></th></tr>
          </thead>
          <tbody>
{{#each r in rows}}
            <tr>
              <td class="min-w-[16rem]">
                <a href="/admin/listings/{{ r.id }}" class="flex items-center gap-3 group">
{{#if r.cover}}
                  <img src="{{ r.cover }}" alt="" class="w-14 h-10 object-cover rounded-md border border-line shrink-0" loading="lazy" />
{{#else}}
                  <span class="w-14 h-10 rounded-md bg-raised shrink-0"></span>
{{/if}}
                  <span class="min-w-0">
                    <span class="block font-medium group-hover:underline truncate max-w-[22rem]">{{ r.title }}</span>
                    <span class="block text-xs text-muted">{{ r.categoryLabel }} · {{ r.location or "—" }}{{ r.fromProperman ? "" : " · Website-only" }}</span>
                  </span>
                </a>
              </td>
              <td class="whitespace-nowrap">{{ Fmt.price(r.price, r.purpose) }}</td>
              <td class="whitespace-nowrap">{{ r.fromProperman ? r.vacantUnits + " / " + r.totalUnits + " vacant" : "—" }}</td>
              <td><div class="flex flex-wrap gap-1">
{{#if r.isPublished}}
                <span class="bb-chip bb-chip-ok">Published</span>
{{#else}}
                <span class="bb-chip bb-chip-muted">Hidden</span>
{{/if}}
{{#if r.status is not "available"}}
                <span class="bb-chip bb-chip-warn">{{ Fmt.label(r.status) }}</span>
{{/if}}
{{#if r.fromProperman}}
                <span class="bb-chip bb-chip-brand" title="Synced from HQ"><IconPlug class="w-3 h-3" /> HQ</span>
{{/if}}
              </div></td>
              <td class="whitespace-nowrap text-xs text-muted">{{ Fmt.ago(r.updatedAt) }}</td>
              <td>
                <button class="tx-icon-btn" aria-pressed="{{ r.isFeatured ? 'true' : 'false' }}" aria-label="{{ r.isFeatured ? 'Remove from featured' : 'Feature on the homepage' }}" title="{{ r.isFeatured ? 'Featured' : 'Feature' }}" disabled="{{ busyId is r.id }}" onclick="{{ toggleFeatured(r) }}">
                  <IconStar class="{{ r.isFeatured ? 'w-4 h-4 text-brand fill-current' : 'w-4 h-4 text-muted' }}" />
                </button>
              </td>
            </tr>
{{/each}}
          </tbody>
        </table>
      </div>
{{/if}}
    </div>
  </div>
