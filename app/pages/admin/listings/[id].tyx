page AdminListingEdit

import AdminNav from "../../components/AdminNav"
import ListingEditor from "../../components/ListingEditor"

title "Edit listing | Barani Better Homes admin"

props
  id: string

needs
  Auth
  Site

permissions
  listings.view

template
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-8 grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-4 lg:gap-8">
    <AdminNav current="listings" />
    <div class="min-w-0">
      <ListingEditor listingId="{{ id }}" />
    </div>
  </div>
