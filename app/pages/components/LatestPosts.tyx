component LatestPosts

import { IconArrowRight } from "tylix-icons"

state
  posts: []
  loading: true

action
  formatDate(value) {
    if not value {
      return ""
    }
    return new Date(value).toLocaleDateString("en-KE", { year: "numeric", month: "short", day: "numeric" })
  }

onMount
  async {
    const result = await useApi("/api/public/posts")
    if result.ok {
      this.posts = result.data.slice(0, 3)
    }
    this.loading = false
  }

template
  <section>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-14 sm:pt-16">
      <div class="flex items-end justify-between mb-5 gap-4">
        <div>
          <p class="tx-eyebrow mb-2">News & guides</p>
          <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight">From the Barani desk</h2>
        </div>
        <a href="/posts" class="tx-btn tx-btn-outline tx-btn-sm shrink-0">View all <IconArrowRight class="w-4 h-4" /></a>
      </div>

{{#if loading}}
      <p class="text-sm text-muted">Loading…</p>
{{#else if posts.length is 0}}
      <p class="text-sm text-muted">Market news and guides will appear here.</p>
{{#else}}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
{{#each p in posts}}
        <a href="{{ `/posts/${p.id}` }}" class="group flex flex-col overflow-hidden tx-panel p-2">
{{#if p.cover_image}}
          <img src="{{ p.cover_image }}" alt="" class="w-full aspect-video object-cover rounded-[14px]" />
{{/if}}
          <div class="p-4">
            <p class="text-xs font-medium text-muted mb-2">{{ formatDate(p.created_at) }} · {{ p.author }}</p>
            <h3 class="font-bold tracking-tight mb-1.5 group-hover:text-link transition-colors">{{ p.title }}</h3>
            <p class="text-sm text-muted leading-relaxed line-clamp-2">{{ p.excerpt }}</p>
          </div>
        </a>
{{/each}}
      </div>
{{/if}}
    </div>
  </section>