component ListingCard

import { IconHeart, IconMapPin, IconBed, IconBath, IconRuler, IconHome } from "tylix-icons"

props
  listing: any

uses
  Saved
  Fmt

computed
  href() {
    return `/properties/${this.listing.slug}`
  }

  facts() {
    const l = this.listing
    const out = []
    if l.bedrooms is not null and l.bedrooms is not undefined and l.category is not "land" {
      out.push({ kind: "bed", text: Fmt.beds(l.bedrooms) })
    }
    if l.bathrooms {
      out.push({ kind: "bath", text: l.bathrooms + (l.bathrooms is 1 ? " bath" : " baths") })
    }
    if l.landSize {
      out.push({ kind: "size", text: l.landSize })
    } else if l.sizeSqm {
      out.push({ kind: "size", text: Math.round(l.sizeSqm) + " m²" })
    }
    return out
  }

  priceLabel() {
    const l = this.listing
    if l.fromProperman and l.purpose is "rent" and l.totalUnits > 1 {
      return "From " + Fmt.price(l.price, "rent")
    }
    return Fmt.price(l.price, l.purpose)
  }

template
  <article class="bb-card h-full">
    <div class="bb-photo">
      <a href="{{ href }}" tabindex="-1" aria-hidden="true">
{{#if listing.cover}}
        <img src="{{ listing.cover }}" alt="" loading="lazy" />
{{#else}}
        <div class="bb-photo-empty"><IconHome class="w-10 h-10" /></div>
{{/if}}
      </a>
      <div class="absolute top-2.5 left-2.5 right-14 flex flex-wrap gap-1.5">
        <span class="{{ listing.purpose is 'sale' ? 'bb-chip bb-chip-dark' : 'bb-chip' }}">{{ listing.purpose is "sale" ? "For sale" : "To let" }}</span>
{{#if listing.status is "under_offer"}}
        <span class="bb-chip"><span class="bb-dot bb-dot-warn"></span> Under offer</span>
{{#else if listing.fromProperman and listing.vacantUnits > 0}}
        <span class="bb-chip"><span class="bb-dot bb-dot-ok"></span> {{ listing.vacantUnits }} vacant</span>
{{/if}}
      </div>
      <button
        class="bb-heart"
        aria-pressed="{{ Saved.has(listing.id) ? 'true' : 'false' }}"
        aria-label="{{ Saved.has(listing.id) ? 'Remove from saved' : 'Save this property' }}"
        onclick.prevent.stop="{{ Saved.toggle(listing.id) }}"
      >
        <IconHeart class="w-[18px] h-[18px]" />
      </button>
    </div>

    <div class="px-2.5 pt-3.5 pb-2 flex flex-col gap-1.5 flex-1">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand dark:text-link">{{ listing.categoryLabel }}</p>
      <p class="text-lg font-bold tracking-tight text-ink -mt-0.5">{{ priceLabel }}</p>
      <h3 class="font-semibold leading-snug">
        <a href="{{ href }}" class="hover:text-link after:absolute after:inset-0 after:content-['']">{{ listing.title }}</a>
      </h3>
      <p class="text-sm text-muted flex items-center gap-1.5"><IconMapPin class="w-4 h-4 shrink-0" /> <span class="truncate">{{ listing.location }}</span></p>
{{#if facts.length > 0}}
      <div class="mt-auto pt-3 border-t border-line flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] font-medium text-soft">
{{#each fact in facts}}
        <span class="inline-flex items-center gap-1.5">
{{#if fact.kind is "bed"}}<IconBed class="w-4 h-4 text-muted" />{{#else if fact.kind is "bath"}}<IconBath class="w-4 h-4 text-muted" />{{#else}}<IconRuler class="w-4 h-4 text-muted" />{{/if}}
          {{ fact.text }}
        </span>
{{/each}}
      </div>
{{/if}}
    </div>
  </article>
