component ListingEditor

import { IconArrowLeft, IconExternalLink, IconStar, IconTrash, IconX, IconImagePlus, IconArrowUp, IconLockClosed } from "tylix-icons"

// Create or edit one listing. listingId is "" for a new Website-only listing.
//
// Properman listings: details, photos, prices and units come from Properman
// on every sync, so only the marketing fields (featured, agent, features)
// are editable here. The API enforces the same split (AdminController).

props
  listingId: string

uses
  Site
  Fmt

state
  loading: true
  loadError: ""
  listing: null
  activity: null
  agents: []
  form: {
    title: "", purpose: "sale", category: "house", location: "", address: "", description: "",
    price: "", bedrooms: "", bathrooms: "", size_sqm: "", land_size: "", status: "available",
    is_published: false, is_featured: false, agent_id: ""
  }
  featuresText: ""
  images: []
  imageUrl: ""
  uploading: false
  saving: false
  deleting: false
  errors: {}
  notice: ""
  formError: ""

computed
  isNew() {
    return not this.listingId
  }

  fromProperman() {
    return Boolean(this.listing and this.listing.source is "properman")
  }

  showBeds() {
    return this.form.category is not "land" and this.form.category is not "commercial" and this.form.category is not "shop" and this.form.category is not "office"
  }

action
  fieldError(field) {
    const list = this.errors[field]
    return Array.isArray(list) and list.length > 0 ? list[0] : ""
  }

  numberOrBlank(value) {
    if value is "" or value is null or value is undefined {
      return ""
    }
    const n = Number(value)
    return Number.isFinite(n) ? n : value
  }

  features() {
    return this.featuresText.split(/[\n,]/).map(f => f.trim()).filter(f => f.length > 0)
  }

  fill(l) {
    this.listing = l
    this.form = {
      title: l.title, purpose: l.purpose, category: l.category, location: l.location, address: l.address,
      description: l.description, price: l.price, bedrooms: l.bedrooms ?? "", bathrooms: l.bathrooms ?? "",
      size_sqm: l.sizeSqm ?? "", land_size: l.landSize ?? "", status: l.status, is_published: l.isPublished,
      is_featured: l.isFeatured, agent_id: l.agentId ? String(l.agentId) : ""
    }
    this.featuresText = l.features.join("\n")
    this.images = l.images.slice()
  }

  async load() {
    this.loading = true
    this.loadError = ""
    const agents = await useApi("/api/admin/agents")
    if agents.ok {
      this.agents = agents.data.data.filter(a => a.isActive)
    }
    if this.listingId {
      const result = await useApi(`/api/admin/listings/${this.listingId}`)
      if result.ok {
        this.fill(result.data.data)
        this.activity = result.data.activity
      } else {
        this.loadError = result.status is 404 ? "This listing doesn't exist any more." : Fmt.firstError(result)
      }
    }
    this.loading = false
  }

  addImageUrl() {
    const url = this.imageUrl.trim()
    if not /^https?:\/\/\S+$/i.test(url) {
      this.errors = { ...this.errors, images: ["Paste a full image address starting with https://"] }
      return null
    }
    if not this.images.includes(url) {
      this.images = [...this.images, url]
    }
    this.imageUrl = ""
    this.errors = { ...this.errors, images: [] }
  }

  removeImage(url) {
    this.images = this.images.filter(i => i is not url)
  }

  makeCover(url) {
    this.images = [url, ...this.images.filter(i => i is not url)]
  }

  async pickImage(event) {
    const file = event.target.files and event.target.files[0]
    event.target.value = ""
    if not file {
      return null
    }
    if not ["image/png", "image/jpeg", "image/webp", "image/gif"].includes(file.type) {
      this.errors = { ...this.errors, images: ["Use a PNG, JPEG, WebP or GIF image."] }
      return null
    }
    if file.size > 2 * 1024 * 1024 {
      this.errors = { ...this.errors, images: ["Each photo must be 2 MB or smaller."] }
      return null
    }
    this.uploading = true
    try {
      const dataUrl = await new Promise((resolve, reject) => {
        const reader = new FileReader()
        reader.onload = () => resolve(reader.result)
        reader.onerror = () => reject(reader.error)
        reader.readAsDataURL(file)
      })
      const result = await useApi("/api/uploads", { method: "POST", body: { data: dataUrl } })
      if result.ok {
        this.images = [...this.images, result.data.url]
        this.errors = { ...this.errors, images: [] }
      } else if result.status is 413 {
        this.errors = { ...this.errors, images: ["The server refused a photo this size. Set MAX_BODY_BYTES=4194304 in .env and restart."] }
      } else {
        this.errors = { ...this.errors, images: [Fmt.firstError(result, "Couldn't upload that photo.")] }
      }
    } catch (err) {
      this.errors = { ...this.errors, images: ["Couldn't read that photo."] }
    } finally {
      this.uploading = false
    }
  }

  fullBody() {
    const f = this.form
    return {
      title: f.title, purpose: f.purpose, category: f.category, location: f.location, address: f.address,
      description: f.description, price: this.numberOrBlank(f.price), bedrooms: this.showBeds ? this.numberOrBlank(f.bedrooms) : "",
      bathrooms: this.showBeds ? this.numberOrBlank(f.bathrooms) : "", size_sqm: this.numberOrBlank(f.size_sqm),
      land_size: f.land_size, status: f.status, is_published: f.is_published, is_featured: f.is_featured,
      agent_id: f.agent_id ? Number(f.agent_id) : null, features: this.features(), images: this.images
    }
  }

  marketingBody() {
    return { is_featured: this.form.is_featured, agent_id: this.form.agent_id ? Number(this.form.agent_id) : null, features: this.features() }
  }

  async save(full) {
    this.saving = true
    this.errors = {}
    this.notice = ""
    this.formError = ""
    const body = full ? this.fullBody() : this.marketingBody()
    const result = this.isNew
      ? await useApi("/api/admin/listings", { method: "POST", body: body })
      : await useApi(`/api/admin/listings/${this.listingId}`, { method: "PUT", body: body })
    this.saving = false
    if result.ok {
      if this.isNew {
        window.location.href = `/admin/listings/${result.data.data.id}?created=1`
        return null
      }
      // The save response has no units (they only change on a sync).
      this.fill({ ...result.data.data, units: this.listing.units })
      this.notice = "Saved."
      return null
    }
    if result.status is 422 and result.data and result.data.errors {
      this.errors = result.data.errors
      this.formError = "Check the highlighted fields."
      return null
    }
    this.formError = Fmt.firstError(result)
  }

  async remove() {
    if not confirm("Delete this listing? This can't be undone.") {
      return null
    }
    this.deleting = true
    const result = await useApi(`/api/admin/listings/${this.listingId}`, { method: "DELETE" })
    this.deleting = false
    if result.ok {
      window.location.href = "/admin/listings?deleted=1"
      return null
    }
    this.formError = Fmt.firstError(result)
  }

onMount
  async {
    if new URLSearchParams(window.location.search).get("created") {
      this.notice = "Listing created."
    }
    await this.load()
  }

template
  <div>
    <a href="/admin/listings" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-ink mb-4"><IconArrowLeft class="w-4 h-4" /> All listings</a>

{{#if loading}}
    <div data-page-loader="true" class="text-sm text-muted">Loading…</div>
{{#else if loadError}}
    <div class="tx-alert tx-alert-error" role="alert"><p class="text-sm">{{ loadError }}</p></div>
{{#else}}
    <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
      <div class="min-w-0">
        <h1 class="text-2xl font-bold tracking-tight">{{ isNew ? "New listing" : listing.title }}</h1>
{{#if listing}}
        <p class="text-sm text-muted mt-1">
          {{ fromProperman ? "From HQ" : "Website-only listing" }} · {{ listing.isPublished ? "Published" : "Not published" }}{{ listing.syncedAt ? " · synced " + Fmt.ago(listing.syncedAt) : "" }}
        </p>
{{/if}}
      </div>
{{#if listing and listing.isPublished}}
      <a href="/properties/{{ listing.slug }}" target="_blank" rel="noopener" class="tx-btn tx-btn-outline tx-btn-sm">View on site <IconExternalLink class="w-4 h-4" /></a>
{{/if}}
    </div>

{{#if notice}}<div class="tx-alert tx-alert-success mb-4" role="status"><p class="text-sm">{{ notice }}</p></div>{{/if}}
{{#if formError}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p class="text-sm">{{ formError }}</p></div>{{/if}}

{{#if activity}}
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-6">
      <div class="tx-panel p-3"><p class="text-lg font-semibold">{{ activity.views }}</p><p class="text-xs text-muted">Views</p></div>
      <div class="tx-panel p-3"><p class="text-lg font-semibold">{{ activity.saves }}</p><p class="text-xs text-muted">Saves</p></div>
      <div class="tx-panel p-3"><p class="text-lg font-semibold">{{ activity.enquiries }}</p><p class="text-xs text-muted">Enquiries</p></div>
      <div class="tx-panel p-3"><p class="text-lg font-semibold">{{ activity.viewings }}</p><p class="text-xs text-muted">Viewings</p></div>
      <div class="tx-panel p-3"><p class="text-lg font-semibold">{{ activity.applications }}</p><p class="text-xs text-muted">Applications</p></div>
    </div>
{{/if}}

{{#if fromProperman}}
    <div class="tx-alert tx-alert-info mb-6 flex items-start gap-2"><IconLockClosed class="w-4 h-4 mt-0.5 shrink-0" /><p class="text-sm">Details, photos, prices and units come from HQ and refresh on every sync. Change them in HQ (the property page's Barani Better Homes website panel). Here you can feature the listing, assign an agent and add selling points.</p></div>

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_340px] gap-6 items-start">
      <section class="tx-panel p-5">
        <h2 class="font-semibold mb-3">From HQ</h2>
        <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-3 text-sm mb-5">
          <div><dt class="text-muted text-xs">Category</dt><dd>{{ listing.categoryLabel }} · {{ Fmt.label(listing.purpose) }}</dd></div>
          <div><dt class="text-muted text-xs">Location</dt><dd>{{ listing.location or "—" }}</dd></div>
          <div><dt class="text-muted text-xs">Price</dt><dd>{{ Fmt.price(listing.price, listing.purpose) }}</dd></div>
          <div><dt class="text-muted text-xs">Vacant units</dt><dd>{{ listing.vacantUnits }} of {{ listing.totalUnits }}</dd></div>
          <div><dt class="text-muted text-xs">HQ property id</dt><dd>{{ listing.externalId }}</dd></div>
          <div><dt class="text-muted text-xs">Photos</dt><dd>{{ listing.images.length }}</dd></div>
        </dl>
{{#if listing.description}}
        <p class="text-sm text-soft whitespace-pre-line mb-5 line-clamp-6">{{ listing.description }}</p>
{{/if}}
        <h3 class="font-semibold text-sm mb-2">Units</h3>
{{#if listing.units.length is 0}}
        <p class="text-sm text-muted">No units synced.</p>
{{#else}}
        <div class="overflow-x-auto">
          <table class="bb-table">
            <thead><tr><th>Unit</th><th>Type</th><th>Rent</th><th>Status</th></tr></thead>
            <tbody>
{{#each u in listing.units}}
              <tr>
                <td>{{ u.name }}</td>
                <td>{{ u.type or Fmt.beds(u.bedrooms) or "—" }}</td>
                <td>{{ Fmt.kes(u.rent) }}</td>
                <td><span class="{{ u.isListed ? 'bb-chip bb-chip-ok' : 'bb-chip bb-chip-muted' }}">{{ u.isListed ? "Vacant, listed" : (u.isVacant ? "Vacant, hidden" : "Occupied") }}</span></td>
              </tr>
{{/each}}
            </tbody>
          </table>
        </div>
{{/if}}
      </section>

      <form class="tx-panel p-5" onsubmit.prevent="{{ save(false) }}" novalidate>
        <h2 class="font-semibold mb-3">Marketing</h2>
        <label class="flex items-center gap-2 text-sm mb-4"><input type="checkbox" bind:checked="{{ form.is_featured }}" /> <IconStar class="w-4 h-4 text-brand" /> Feature on the homepage</label>
        <label class="tx-label" for="le-agent">Agent</label>
        <select id="le-agent" class="tx-input" bind:value="{{ form.agent_id }}">
          <option value="">Office contact (no agent)</option>
{{#each a in agents}}
          <option value="{{ a.id }}">{{ a.name }}</option>
{{/each}}
        </select>
        <label class="tx-label" for="le-features">Selling points</label>
        <textarea id="le-features" class="tx-input" rows="5" placeholder="One per line, e.g. Borehole water" bind:value="{{ featuresText }}"></textarea>
        <button type="submit" class="tx-btn tx-btn-primary" disabled="{{ saving }}">{{ saving ? "Saving…" : "Save marketing details" }}</button>
      </form>
    </div>
{{#else if not isNew and not can("listings.manage")}}
    <form class="tx-panel p-5 max-w-xl" onsubmit.prevent="{{ save(false) }}" novalidate>
      <p class="text-sm text-muted mb-4">Your role can feature this listing, assign its agent and edit its selling points.</p>
      <label class="flex items-center gap-2 text-sm mb-4"><input type="checkbox" bind:checked="{{ form.is_featured }}" /> <IconStar class="w-4 h-4 text-brand" /> Feature on the homepage</label>
      <label class="tx-label" for="le-agent2">Agent</label>
      <select id="le-agent2" class="tx-input" bind:value="{{ form.agent_id }}">
        <option value="">Office contact (no agent)</option>
{{#each a in agents}}
        <option value="{{ a.id }}">{{ a.name }}</option>
{{/each}}
      </select>
      <label class="tx-label" for="le-features2">Selling points</label>
      <textarea id="le-features2" class="tx-input" rows="5" bind:value="{{ featuresText }}"></textarea>
      <button type="submit" class="tx-btn tx-btn-primary" disabled="{{ saving }}">{{ saving ? "Saving…" : "Save" }}</button>
    </form>
{{#else}}
    <form class="grid grid-cols-1 xl:grid-cols-[1fr_340px] gap-6 items-start" onsubmit.prevent="{{ save(true) }}" novalidate>
      <div class="tx-panel p-5 min-w-0">
        <label class="tx-label" for="le-title">Title</label>
        <input id="le-title" class="tx-input" maxlength="200" placeholder="e.g. 1/8 acre plot, Kitengela" bind:value="{{ form.title }}" aria-invalid="{{ fieldError('title') ? 'true' : 'false' }}" />
{{#if fieldError("title")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("title") }}</p>{{/if}}

        <div class="grid sm:grid-cols-3 gap-x-4">
          <div>
            <label class="tx-label" for="le-purpose">Purpose</label>
            <select id="le-purpose" class="tx-input" bind:value="{{ form.purpose }}">
              <option value="sale">For sale</option>
              <option value="rent">For rent</option>
            </select>
          </div>
          <div>
            <label class="tx-label" for="le-category">Category</label>
            <select id="le-category" class="tx-input" bind:value="{{ form.category }}">
{{#each c in Site.categories}}
              <option value="{{ c.key }}">{{ c.label }}</option>
{{/each}}
            </select>
          </div>
          <div>
            <label class="tx-label" for="le-status">Status</label>
            <select id="le-status" class="tx-input" bind:value="{{ form.status }}">
              <option value="available">Available</option>
              <option value="under_offer">Under offer</option>
              <option value="let">Let (hidden from search)</option>
              <option value="sold">Sold (hidden from search)</option>
            </select>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-x-4">
          <div>
            <label class="tx-label" for="le-location">Area / town</label>
            <input id="le-location" class="tx-input" placeholder="e.g. Nyali, Mombasa" bind:value="{{ form.location }}" aria-invalid="{{ fieldError('location') ? 'true' : 'false' }}" />
{{#if fieldError("location")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("location") }}</p>{{/if}}
          </div>
          <div>
            <label class="tx-label" for="le-address">Address or landmark (optional)</label>
            <input id="le-address" class="tx-input" bind:value="{{ form.address }}" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-x-4">
          <div>
            <label class="tx-label" for="le-price">{{ form.purpose is "rent" ? "Monthly rent (KES)" : "Asking price (KES)" }}</label>
            <input id="le-price" class="tx-input" type="number" min="0" step="1000" bind:value="{{ form.price }}" aria-invalid="{{ fieldError('price') ? 'true' : 'false' }}" />
{{#if fieldError("price")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("price") }}</p>{{/if}}
          </div>
          <div>
            <label class="tx-label" for="le-land">{{ form.category is "land" ? "Plot size" : "Land size (optional)" }}</label>
            <input id="le-land" class="tx-input" placeholder="e.g. 50 x 100 ft, 1/4 acre" bind:value="{{ form.land_size }}" />
          </div>
        </div>

        <div class="grid grid-cols-3 gap-x-4">
{{#if showBeds}}
          <div>
            <label class="tx-label" for="le-beds">Bedrooms</label>
            <input id="le-beds" class="tx-input" type="number" min="0" max="50" bind:value="{{ form.bedrooms }}" aria-invalid="{{ fieldError('bedrooms') ? 'true' : 'false' }}" />
{{#if fieldError("bedrooms")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("bedrooms") }}</p>{{/if}}
          </div>
          <div>
            <label class="tx-label" for="le-baths">Bathrooms</label>
            <input id="le-baths" class="tx-input" type="number" min="0" max="50" bind:value="{{ form.bathrooms }}" aria-invalid="{{ fieldError('bathrooms') ? 'true' : 'false' }}" />
{{#if fieldError("bathrooms")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("bathrooms") }}</p>{{/if}}
          </div>
{{/if}}
          <div>
            <label class="tx-label" for="le-size">Floor area (m²)</label>
            <input id="le-size" class="tx-input" type="number" min="0" bind:value="{{ form.size_sqm }}" aria-invalid="{{ fieldError('size_sqm') ? 'true' : 'false' }}" />
{{#if fieldError("size_sqm")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("size_sqm") }}</p>{{/if}}
          </div>
        </div>

        <label class="tx-label" for="le-description">Description</label>
        <textarea id="le-description" class="tx-input" rows="7" bind:value="{{ form.description }}" aria-invalid="{{ fieldError('description') ? 'true' : 'false' }}"></textarea>
{{#if fieldError("description")}}<p class="text-xs text-coral -mt-3 mb-3">{{ fieldError("description") }}</p>{{/if}}

        <label class="tx-label" for="le-features3">Selling points</label>
        <textarea id="le-features3" class="tx-input" rows="4" placeholder="One per line, e.g. Title deed ready" bind:value="{{ featuresText }}"></textarea>

        <h2 class="font-semibold mt-2 mb-1">Photos</h2>
        <p class="text-xs text-muted mb-3">The first photo is the cover.</p>
{{#if images.length > 0}}
        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-3">
{{#each img, i in images}}
          <li class="relative">
            <img src="{{ img }}" alt="Photo {{ i + 1 }}" class="w-full aspect-[4/3] object-cover rounded-lg border border-line" />
            <div class="absolute top-1.5 right-1.5 flex gap-1">
{{#if i > 0}}
              <button type="button" class="tx-icon-btn bg-panel/90" title="Make cover photo" aria-label="Make photo {{ i + 1 }} the cover" onclick="{{ makeCover(img) }}"><IconArrowUp class="w-4 h-4" /></button>
{{/if}}
              <button type="button" class="tx-icon-btn bg-panel/90" title="Remove" aria-label="Remove photo {{ i + 1 }}" onclick="{{ removeImage(img) }}"><IconX class="w-4 h-4" /></button>
            </div>
{{#if i is 0}}<span class="absolute bottom-1.5 left-1.5 bb-chip bb-chip-brand">Cover</span>{{/if}}
          </li>
{{/each}}
        </ul>
{{/if}}
        <div class="flex flex-wrap items-center gap-3 mb-2">
          <label class="tx-btn tx-btn-outline tx-btn-sm cursor-pointer">
            <IconImagePlus class="w-4 h-4" /> {{ uploading ? "Uploading…" : "Upload photo" }}
            <input type="file" class="sr-only" accept="image/png,image/jpeg,image/webp,image/gif" onchange="{{ pickImage($event) }}" disabled="{{ uploading }}" />
          </label>
          <div class="flex gap-2 flex-1 min-w-[14rem]">
            <input class="tx-input !mb-0" placeholder="…or paste an image URL" aria-label="Image URL" bind:value="{{ imageUrl }}" />
            <button type="button" class="tx-btn tx-btn-ghost tx-btn-sm" onclick="{{ addImageUrl() }}">Add</button>
          </div>
        </div>
{{#if fieldError("images")}}<p class="text-xs text-coral mb-3">{{ fieldError("images") }}</p>{{/if}}
      </div>

      <aside class="tx-panel p-5 xl:sticky xl:top-20">
        <h2 class="font-semibold mb-3">Publishing</h2>
        <label class="flex items-center gap-2 text-sm mb-3"><input type="checkbox" bind:checked="{{ form.is_published }}" /> Show on the public site</label>
        <label class="flex items-center gap-2 text-sm mb-4"><input type="checkbox" bind:checked="{{ form.is_featured }}" /> <IconStar class="w-4 h-4 text-brand" /> Feature on the homepage</label>
        <label class="tx-label" for="le-agent3">Agent</label>
        <select id="le-agent3" class="tx-input" bind:value="{{ form.agent_id }}">
          <option value="">Office contact (no agent)</option>
{{#each a in agents}}
          <option value="{{ a.id }}">{{ a.name }}</option>
{{/each}}
        </select>
        <button type="submit" class="tx-btn tx-btn-primary tx-btn-block" disabled="{{ saving or uploading }}">{{ saving ? "Saving…" : (isNew ? "Create listing" : "Save changes") }}</button>
{{#if not isNew}}
        <button type="button" class="tx-btn tx-btn-ghost tx-btn-block mt-2 text-coral" disabled="{{ deleting }}" onclick="{{ remove() }}"><IconTrash class="w-4 h-4" /> Delete listing</button>
        <p class="text-xs text-muted mt-2">Listings with enquiries or applications can't be deleted; unpublish them instead.</p>
{{/if}}
      </aside>
    </form>
{{/if}}
{{/if}}
  </div>
