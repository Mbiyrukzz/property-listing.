component SiteFooter

import { IconPhone, IconMail, IconMapPin, IconWhatsapp } from "tylix-icons"

uses
  Site
  Fmt

state
  year: 2026
  browse: [
    { label: "Houses & apartments to rent", href: "/rent" },
    { label: "Property for sale", href: "/buy" },
    { label: "Vacant units", href: "/vacant-units" },
    { label: "Land & plots", href: "/land" },
    { label: "Offices & shops", href: "/commercial" },
    { label: "Landlord services", href: "/p/about#landlords" }
  ]
  account: [
    { label: "My account", href: "/dashboard" },
    { label: "Saved properties", href: "/account/saved" },
    { label: "Tenant portal", href: "/tenant" },
    { label: "Create an account", href: "/register" }
  ]

onMount
  {
    this.year = new Date().getFullYear()
  }

template
  <footer class="mt-20 px-0 sm:px-3 sm:pb-3">
    <div class="bb-footer sm:rounded-[28px] overflow-hidden">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-12 pb-10 grid grid-cols-2 md:grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-2 md:col-span-4">
          <a href="/" class="!text-white flex items-center gap-2.5 mb-4">
            <span class="bb-logo"><img src="/barani-mark.png" alt="" width="97" height="87" /></span>
            <span class="text-[17px] font-bold tracking-tight">{{ Site.settings.site_name }}</span>
          </a>
          <p class="text-sm leading-relaxed max-w-xs opacity-75">{{ Site.settings.about_short }}</p>
          <div class="flex flex-wrap gap-2 mt-5">
{{#if Site.settings.phone}}
            <a href="{{ `tel:${Site.settings.phone}` }}" class="bb-hero-pill"><IconPhone class="w-4 h-4" /> Call</a>
{{/if}}
{{#if Site.settings.whatsapp}}
            <a href="{{ Fmt.whatsapp(Site.settings.whatsapp, '') }}" class="bb-hero-pill" rel="noopener" target="_blank"><IconWhatsapp class="w-4 h-4" /> WhatsApp</a>
{{/if}}
{{#if Site.settings.email}}
            <a href="{{ `mailto:${Site.settings.email}` }}" class="bb-hero-pill"><IconMail class="w-4 h-4" /> Email</a>
{{/if}}
          </div>
        </div>

        <div class="md:col-span-2 md:col-start-6">
          <h2 class="text-xs font-bold uppercase tracking-[0.12em] mb-4">Browse</h2>
          <ul class="space-y-2.5">
{{#each link in browse}}
            <li><a href="{{ link.href }}" class="text-sm">{{ link.label }}</a></li>
{{/each}}
          </ul>
        </div>

        <div class="md:col-span-2">
          <h2 class="text-xs font-bold uppercase tracking-[0.12em] mb-4">Your account</h2>
          <ul class="space-y-2.5">
{{#each link in account}}
            <li><a href="{{ link.href }}" class="text-sm">{{ link.label }}</a></li>
{{/each}}
{{#each page in Site.pages}}
            <li><a href="{{ `/p/${page.slug}` }}" class="text-sm">{{ page.title }}</a></li>
{{/each}}
          </ul>
        </div>

        <div class="col-span-2 md:col-span-3">
          <h2 class="text-xs font-bold uppercase tracking-[0.12em] mb-4">Talk to us</h2>
          <ul class="space-y-2.5 text-sm">
{{#if Site.settings.phone}}
            <li><a href="{{ `tel:${Site.settings.phone}` }}" class="flex items-center gap-2"><IconPhone class="w-4 h-4 shrink-0" /> {{ Site.settings.phone }}</a></li>
{{/if}}
{{#if Site.settings.whatsapp}}
            <li><a href="{{ Fmt.whatsapp(Site.settings.whatsapp, '') }}" class="flex items-center gap-2" target="_blank" rel="noopener"><IconWhatsapp class="w-4 h-4 shrink-0" /> {{ Site.settings.whatsapp }}</a></li>
{{/if}}
{{#if Site.settings.email}}
            <li><a href="{{ `mailto:${Site.settings.email}` }}" class="flex items-center gap-2 break-all"><IconMail class="w-4 h-4 shrink-0" /> {{ Site.settings.email }}</a></li>
{{/if}}
{{#if Site.settings.address}}
            <li class="flex items-start gap-2 opacity-75"><IconMapPin class="w-4 h-4 mt-0.5 shrink-0" /> {{ Site.settings.address }}</li>
{{/if}}
{{#if Site.settings.office_hours}}
            <li class="flex items-center gap-2 text-xs opacity-75"><span class="bb-dot bb-dot-ok"></span> {{ Site.settings.office_hours }}</li>
{{/if}}
            <li><a href="/contact" class="font-semibold !text-white hover:underline">Send us a message →</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-xs opacity-70">
          <p>© {{ year }} {{ Site.settings.site_name }}. Rental availability is updated automatically.</p>
          <p>Designed and developed by <a href="https://ashmif.com" class="font-semibold underline-offset-2 hover:underline" target="_blank" rel="noopener">Ashmif Office Solutions</a> · Built with <a href="https://tylix.dev" class="font-semibold underline-offset-2 hover:underline" target="_blank" rel="noopener">Tylix</a></p>
        </div>
      </div>
    </div>
  </footer>
