component SiteNavbar

import { IconSun, IconMoon, IconMenu, IconX, IconHeart, IconUserCircle, IconLayoutGrid, IconKey, IconHome, IconBuildingOffice, IconTree, IconNewspaper, IconChatBubble, IconLogout, IconTag } from "tylix-icons"

uses
  Auth
  Theme
  Site

state
  mobileMenuOpen: false
  links: [
    { label: "Rent", href: "/rent" },
    { label: "Buy", href: "/buy" },
    { label: "Vacant units", href: "/vacant-units" },
    { label: "Land", href: "/land" },
    { label: "Commercial", href: "/commercial" },
    { label: "News", href: "/posts" }
  ]

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }

  isActive(href) {
    const path = window.location.pathname
    return path is href or path.startsWith(href + "/")
  }

  linkClass(href) {
    return this.isActive(href) ? "bb-nav-link is-active" : "bb-nav-link"
  }

  sheetClass(href) {
    return this.isActive(href) ? "bb-sheet-link is-active" : "bb-sheet-link"
  }

template
  <header class="tx-nav">
    <nav class="max-w-7xl mx-auto h-16 px-4 sm:px-6 flex items-center justify-between gap-4" aria-label="Main">
      <div class="flex items-center gap-8 min-w-0">
        <a href="/" class="flex items-center gap-2.5 min-w-0" aria-label="{{ Site.settings.site_name }} home">
          <span class="bb-logo"><img src="/barani-mark.png" alt="" width="97" height="87" /></span>
          <span class="text-base sm:text-[17px] font-bold tracking-tight truncate">{{ Site.settings.site_name }}</span>
        </a>

        <div class="hidden lg:flex items-center gap-1">
{{#each link in links}}
          <a href="{{ link.href }}" class="{{ linkClass(link.href) }}">{{ link.label }}</a>
{{/each}}
          <a href="/p/about#landlords" class="hidden xl:inline-flex bb-nav-link">For landlords</a>
        </div>
      </div>

      <div class="flex items-center gap-1 shrink-0">
        <button onclick="{{ Theme.toggle() }}" aria-label="Toggle colour theme" class="tx-icon-btn">
{{#if Theme.mode is "dark"}}
          <IconSun class="w-[18px] h-[18px]" />
{{#else}}
          <IconMoon class="w-[18px] h-[18px]" />
{{/if}}
        </button>

{{#if Auth.user}}
        <a href="/account/saved" class="tx-icon-btn" aria-label="Saved properties"><IconHeart class="w-[18px] h-[18px]" /></a>
{{#if can("admin.access")}}
        <a href="/admin" class="hidden md:inline-flex bb-nav-link gap-1.5"><IconLayoutGrid class="w-4 h-4" /> Admin</a>
{{/if}}
        <a href="/dashboard" class="hidden sm:inline-flex tx-btn tx-btn-dark tx-btn-sm ml-1"><IconUserCircle class="w-4 h-4" /> My account</a>
{{#else}}
        <a href="/login" class="hidden sm:inline-flex bb-nav-link">Log in</a>
        <a href="/register" class="hidden sm:inline-flex tx-btn tx-btn-primary tx-btn-sm ml-1">Create account</a>
{{/if}}

        <button
          onclick="{{ toggleMobileMenu() }}"
          aria-label="Toggle menu"
          aria-expanded="{{ mobileMenuOpen }}"
          aria-controls="mobile-menu"
          class="lg:hidden tx-icon-btn"
        >
{{#if mobileMenuOpen}}
          <IconX class="w-5 h-5" />
{{#else}}
          <IconMenu class="w-5 h-5" />
{{/if}}
        </button>
      </div>
    </nav>

{{#if mobileMenuOpen}}
    <div id="mobile-menu" class="lg:hidden border-t border-line bg-panel max-h-[calc(100dvh-4rem)] overflow-y-auto">
      <div class="max-w-7xl mx-auto px-3 sm:px-5 pt-3 pb-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-0.5">
{{#each link in links}}
          <a href="{{ link.href }}" onclick="{{ closeMobileMenu() }}" class="{{ sheetClass(link.href) }}">
{{#if link.href is "/rent"}}<IconKey />{{#else if link.href is "/buy"}}<IconTag />{{#else if link.href is "/vacant-units"}}<IconHome />{{#else if link.href is "/land"}}<IconTree />{{#else if link.href is "/commercial"}}<IconBuildingOffice />{{#else}}<IconNewspaper />{{/if}}
            {{ link.label }}
          </a>
{{/each}}
          <a href="/p/about#landlords" onclick="{{ closeMobileMenu() }}" class="{{ sheetClass('/p/about') }}"><IconBuildingOffice /> For landlords</a>
          <a href="/contact" onclick="{{ closeMobileMenu() }}" class="{{ sheetClass('/contact') }}"><IconChatBubble /> Contact us</a>
        </div>

        <div class="h-px bg-line my-3 mx-2"></div>

{{#if Auth.user}}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-0.5">
          <a href="/dashboard" class="{{ sheetClass('/dashboard') }}"><IconUserCircle /> My account</a>
          <a href="/tenant" class="{{ sheetClass('/tenant') }}"><IconKey /> Tenant portal</a>
{{#if can("admin.access")}}
          <a href="/admin" class="{{ sheetClass('/admin') }}"><IconLayoutGrid /> Admin</a>
{{/if}}
          <button onclick="{{ Auth.logout() }}" class="bb-sheet-link"><IconLogout /> Log out</button>
        </div>
{{#else}}
        <div class="grid grid-cols-2 gap-2 px-1">
          <a href="/login" onclick="{{ closeMobileMenu() }}" class="tx-btn tx-btn-outline">Log in</a>
          <a href="/register" onclick="{{ closeMobileMenu() }}" class="tx-btn tx-btn-primary">Create account</a>
        </div>
{{/if}}
      </div>
    </div>
{{/if}}
  </header>
